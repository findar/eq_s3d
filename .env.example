# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Path to your EQ install (for the zone analyzer)
EQ_PATH=C:/EverQuest

# AI provider keys (only the one you use is required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Image generation (for texture creation)
STABILITY_API_KEY=sk-...

# Viewer port (default: 5173)
VIEWER_PORT=5173
