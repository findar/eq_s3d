coverage.xml

# Logs
*.log
logs/

# Web frontend
web/node_modules/
web/dist/
web/package-lock.json

# Generated web output
output/web/

# Agent migration backups (one-time .json -> IDE 1.0 schema; local safety copies)
.kiro/agents/*.bak

# Kiro task-runner execution state (tool-local, regenerated)
.kiro/specs/*/tasks.meta.json
